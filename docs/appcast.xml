<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparkle's update feed, served by GitHub Pages from this directory.

  Newest item first. Each entry is generated by Scripts/release.sh into
  dist/appcast-item.xml and pasted in by hand, deliberately, after the GitHub release
  exists: publishing an entry is what offers the update to every install, and doing it
  before the download is uploaded points every user at a 404.

  The sparkle:edSignature on each enclosure is the whole security model. This app is not
  notarized, so Apple has vouched for nothing; the EdDSA signature is the only thing
  between this file and arbitrary code running on every install. Never hand-edit a
  signature, and never publish an item without one.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
    <channel>
        <title>TabSwitcher</title>
        <link>https://sagarnanera.github.io/tab-switcher/appcast.xml</link>
        <description>Updates for TabSwitcher</description>
        <language>en</language>
        <!-- No items yet: nothing has been released. Sparkle treats an empty channel as
             "you are up to date", which is correct. -->
    </channel>
</rss>
